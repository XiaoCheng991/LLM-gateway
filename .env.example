# 复制为 .env 后填入真实值。.env 已被 gitignore，本模板只含占位符、可以入库。
# 启动：set -a; source .env; set +a; mvn spring-boot:run
# （注意：spring-dotenv 在 Spring Boot 4 下不会加载，必须 source，详见台账"环境约定"）
NVIDIA_API_KEY=nvapi-your-key-here
OPENROUTER_API_KEY=sk-or-your-key-here
AGNES_API_KEY=your-key-here

# /api/agent/compact 端点的调用密钥（生成：openssl rand -hex 16）
COMPACT_SECRET=change-me-16bytes-hex

# 可选：Agent 文件工具的安全根目录（默认 data/workspace）
# WORKSPACE_DIR=data/workspace
