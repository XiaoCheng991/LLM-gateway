# 复制为 .env 后填入真实 Key。.env 已被 gitignore，本模板只含占位符、可以入库。
# 启动（二选一）：
#   方式一（推荐）：mvn spring-boot:run           # spring-dotenv 自动读取 .env
#   方式二：set -a; source .env; set +a; mvn spring-boot:run
NVIDIA_API_KEY=nvapi-your-key-here
OPENROUTER_API_KEY=sk-or-your-key-here
AGNES_API_KEY=your-key-here

# 可选：Agent 文件工具的安全根目录（默认 data/workspace）
# WORKSPACE_DIR=data/workspace
